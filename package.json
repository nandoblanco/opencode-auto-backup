{
  "name": "@nandoblanco/opencode-local-backup",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Local-first, zero-token automatic pre-edit file backup plugin for OpenCode with smart project-root resolution, multi-file patch support, retention pruning, and an interactive /backups diff and restore TUI popup.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./server": "./index.js",
    "./tui": "./tui.ts"
  },
  "bin": {
    "opencode-local-backup": "index.js"
  },
  "files": [
    "index.js",
    "tui.ts",
    "assets/screenshot.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --no-warnings --test test/backup.test.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "local-first",
    "zero-token",
    "backup",
    "auto-backup",
    "restore",
    "undo",
    "snapshots",
    "tui"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=2.0.0",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "author": "nandoblanco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandoblanco/opencode-local-backup.git"
  }
}
